@startuml model-danych
' Diagram ERD systemu Sprawnik — notacja Information Engineering (crow's foot)
hide circle
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Sans
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor #FEFEFE
  BorderColor #444444
  ArrowColor #444444
}

entity "uzytkownik" as uzytkownik {
  * id : bigserial <<PK>>
  --
  * email : text <<UQ>>
  * haslo_hash : text
  * imie_nazwisko : text
  * rola : rola_uzytkownika
  * aktywny : boolean
  * utworzono : timestamptz
}

entity "sprawa" as sprawa {
  * id : bigserial <<PK>>
  --
  * uzytkownik_id : bigint <<FK>>
  grupa_id : bigint <<FK>>
  * tytul : text
  znak_wlasny : text
  organ : text
  * status : status_sprawy
  data_wszczecia : date
  opis : text
  * utworzono : timestamptz
}

entity "profil_firmy" as firma {
  * id : smallint <<PK, singleton>>
  --
  * nazwa : text
  * nip : text
  * email : text
  * telefon : text
  * adres : text
  * strona_www : text
  * zmieniono : timestamptz
}

entity "grupa_spraw" as grupa {
  * id : bigserial <<PK>>
  --
  rodzic_id : bigint <<FK>>
  * nazwa : text
  * kolejnosc : integer
}

entity "kontakt" as kontakt {
  * id : bigserial <<PK>>
  --
  * typ : text
  * nazwa : text
  * nip : text
  * email : text
  * telefon : text
  * adres : text
  * adres_edoreczen : text
  * skrzynka_epuap : text
  * osoba_kontaktowa : text
  * notatka : text
  * aktywny : boolean
  * utworzono : timestamptz
  * zmieniono : timestamptz
}

entity "pismo" as pismo {
  * id : bigserial <<PK>>
  --
  * sprawa_id : bigint <<FK>>
  * kierunek : kierunek_pisma
  * rodzaj : text
  * korespondent : text
  kontakt_id : bigint <<FK>>
  dane_korespondenta : jsonb
  znak_pisma : text
  data_nadania : date
  data_doreczenia : date
  opis : text
  kanal : text
  numer_nadania : text
  odpowiedz_na_pismo_id : bigint <<FK>>
  * utworzono : timestamptz
}

entity "dokument" as dokument {
  * id : bigserial <<PK>>
  --
  * pismo_id : bigint <<FK>>
  * dodal_uzytkownik_id : bigint <<FK>>
  * nazwa_oryginalna : text
  * nazwa_w_magazynie : text <<UQ>>
  * typ_mime : text
  * rozmiar_bajtow : bigint
  suma_kontrolna : text
  * rola : text
  * dodano : timestamptz
}

entity "dokument_ocr" as ocr {
  * dokument_id : bigint <<PK,FK>>
  --
  * tekst : text
  * jezyki : text
  * liczba_stron : integer
  * wykonano : timestamptz
}

entity "regula_terminu" as regula {
  * id : bigserial <<PK>>
  --
  * nazwa : text <<UQ>>
  * liczba_dni : integer
  * sposob_liczenia : sposob_liczenia
  * zdarzenie_poczatkowe : zdarzenie_poczatkowe
  * przesuwaj_dni_wolne : boolean
  opis : text
  * aktywna : boolean
  * utworzono : timestamptz
}

entity "termin" as termin {
  * id : bigserial <<PK>>
  --
  * sprawa_id : bigint <<FK>>
  pismo_id : bigint <<FK>>
  regula_id : bigint <<FK>>
  * czynnosc : text
  * data_poczatkowa : date
  * data_uplywu : date
  * sposob_wyznaczenia : sposob_wyznaczenia
  * status : status_terminu
  data_wykonania : date
  * utworzono : timestamptz
}

entity "dzien_wolny" as dzien {
  * data : date <<PK>>
  --
  * nazwa : text
}

grupa      |o--o{ grupa       : podgrupy_bez_cykli
grupa      |o--o{ sprawa      : klasyfikuje
uzytkownik ||--o{ sprawa      : prowadzi
uzytkownik ||--o{ dokument    : dodaje
kontakt    |o--o{ pismo       : dane_z_ksiazki_i_kopia
sprawa     ||--o{ pismo       : zawiera
sprawa     ||--o{ termin      : ma
pismo      ||--o{ dokument    : ma_zalaczone
pismo      ||--o{ termin      : jest_podstawa
pismo      |o--o{ pismo       : odpowiedz_w_tej_samej_sprawie
dokument   ||--o| ocr         : rozpoznany_tekst
regula     ||--o{ termin      : wyznacza

note bottom of dzien
  Kalendarz dni ustawowo wolnych,
  w tym ruchomych, zależnych od Wielkanocy.
  Soboty i niedziele nie są zapisywane —
  wynikają z samej daty.
  Tabela bez relacji — czytana przy
  wyznaczaniu terminu.
end note

note bottom of termin
  Stany „zbliżający się" i „przekroczony"
  nie są przechowywane. Wynikają z porównania
  data_uplywu z datą bieżącą — zapisane
  zdezaktualizowałyby się nazajutrz.
end note

note bottom of firma
  Jeden profil w instalacji, id = 1.
  Grupy są wspólne, sprawy zachowują
  dotychczasowego właściciela.
end note

note bottom of kontakt
  Wspólna książka organizacji.
  Przy piśmie pozostaje kopia danych.
  Edycja kontaktu nie zmienia historii.
end note

@enduml
