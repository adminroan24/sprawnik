@startuml przypadki-uzycia
' Diagram przypadków użycia systemu Sprawnik — zakres podstawowy (F1-F8)
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Sans
skinparam defaultFontSize 12
skinparam usecase {
  BackgroundColor #FEFEFE
  BorderColor #444444
  ArrowColor #444444
}
skinparam actor {
  BackgroundColor #FEFEFE
  BorderColor #444444
}
skinparam rectangle {
  BorderColor #444444
  FontStyle bold
}

actor "Użytkownik" as U
actor "Administrator" as A
actor "Zegar systemowy" as Z

rectangle "Sprawnik" {
  usecase "UC1\nRejestracja sprawy" as UC1
  usecase "UC2\nPrzegląd i edycja sprawy" as UC2
  usecase "UC3\nRejestracja pisma\nprzychodzącego" as UC3
  usecase "UC4\nRejestracja pisma\nwychodzącego" as UC4
  usecase "UC5\nDołączenie dokumentu" as UC5
  usecase "UC6\nDefiniowanie reguły\nterminu" as UC6
  usecase "UC7\nWyznaczenie terminu" as UC7
  usecase "UC8\nPrzegląd terminów" as UC8
  usecase "UC9\nOstrzeganie o terminach" as UC9
  usecase "UC10\nWyszukiwanie\ni filtrowanie" as UC10
  usecase "UC11\nGenerowanie\nchronologii sprawy" as UC11
  usecase "UC12\nUwierzytelnienie" as UC12
  usecase "UC14\nEdycja profilu firmy\n(rozszerzenie)" as UC14
  usecase "UC15\nEdycja drzewa grup\n(rozszerzenie)" as UC15
  usecase "UC16\nPrzypisanie własnej sprawy do grupy\n(rozszerzenie)" as UC16
  usecase "UC17\nPrzegląd i wybór kontaktu\n(rozszerzenie)" as UC17
  usecase "UC18\nEdycja książki adresowej\n(rozszerzenie)" as UC18
  usecase "UC13\nZarządzanie\nużytkownikami" as UC13
}

U --> UC1
U --> UC17
U --> UC16
U --> UC2
U --> UC3
U --> UC4
U --> UC8
U --> UC10
U --> UC11
U --> UC12

A --> UC6
A --> UC18
A --> UC14
A --> UC15
A --> UC13
A --> UC12

Z --> UC9

' Rejestracja pisma przychodzącego zawsze pociąga za sobą wyznaczenie terminu.
UC3 ..> UC7 : <<include>>

' Dołączenie dokumentu jest krokiem opcjonalnym, rozszerzającym rejestrację pisma.
UC5 ..> UC3 : <<extend>>
UC5 ..> UC4 : <<extend>>

note right of UC7
  Termin liczony od daty doręczenia,
  według reguły wskazanej dla pisma
end note

@enduml
