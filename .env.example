# Baza danych
DATABASE_URL=postgresql://sprawnik:sprawnik@localhost:5435/sprawnik

# API
PORT=3100

# Opcjonalnie: magazyn plików (domyślnie uploads/ względem katalogu uruchomienia API)
# UPLOAD_DIR=/sciezka/do/magazynu

# Bezpośrednie skanowanie SANE, dostępne administratorowi po włączeniu
SCANNER_ENABLED=false

# Uwierzytelnianie
JWT_SECRET=zmien-to-na-losowy-ciag
JWT_EXPIRES_IN=7d

# Skrzynka skanów: podkatalogi epson/ i kyocera/. Archiwum poza udziałem SMB.
# SCAN_INBOX_DIR=/sciezka/do/skanow
# SCAN_ARCHIVE_DIR=/sciezka/do/archiwum

# Stały odczyt skrzynki skanów (lokalny OCR, bez automatycznego importu)
SCAN_WATCH_ENABLED=false
# API nasłuchuje domyślnie tylko na komputerze lokalnym
HOST=127.0.0.1
# Cel proxy frontendu, jeśli API działa na innym porcie niż 3100
# API_PROXY_TARGET=http://127.0.0.1:33119
